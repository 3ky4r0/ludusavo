<Window x:Class="SaveSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveSync.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="icon-512.ico"
        Height="720" Width="1080"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <DockPanel>
        <!-- Top Status Bar: Title, Status -->
        <Border DockPanel.Dock="Top"
                Background="#FFFFFF"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SaveSync"
                               FontSize="17" FontWeight="Bold"
                               Foreground="#111111"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Đồng bộ Game Save lên GitHub"
                               FontSize="12" Foreground="#666666"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- GitHub Connection Status Badge -->
                <Border Grid.Column="2"
                        Background="#F5F5F5"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9"
                                 Fill="{Binding IsGitHubConnected, Converter={StaticResource BoolToBrushConverter}}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GitHubStatusText}"
                                   FontSize="12"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- TabControl: Standard WPF TabControl with clear tabs (no icons) -->
        <TabControl x:Name="MainTabs" Margin="8">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="24,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Game trên máy" x:Name="TabGames">
                <Frame x:Name="GamesFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
            <TabItem Header="Sao lưu Cloud" x:Name="TabCloud">
                <Frame x:Name="CloudFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
            <TabItem Header="Cài đặt" x:Name="TabSettings">
                <Frame x:Name="SettingsFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
