{
  "name": "savesync",
  "version": "1.0.0",
  "description": "Lightweight personal game-save synchronization with Ludusavi manifest and private GitHub storage",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/**/*.test.js",
    "build:exe": "pkg . --targets node26-win-x64 --output SaveSync.exe && node scripts/patch-subsystem.js"
  },
  "pkg": {
    "scripts": "server/**/*.js",
    "assets": [
      "web/**/*",
      "assets/**/*",
      "data/cache/manifest_processed.json"
    ]
  },
  "keywords": [
    "game-save",
    "sync",
    "ludusavi",
    "backup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "resedit": "^3.1.0"
  }
}
